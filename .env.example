# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=motipaper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=motipaper
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=change_this_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── MinIO ─────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=motipaper

# ── Firebase (FCM) ────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Redis (optional, for rate-limiting / queues) ──────────
REDIS_URL=redis://redis:6379
